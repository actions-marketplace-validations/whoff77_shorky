# Shorky — example environment configuration.
# Copy this file to `.env` and fill in the values you need. `.env` is
# gitignored; never commit real API keys.

# Required for LLM-based auto-fix generation (codeFixer.ts) and AI vision
# assertions (healingEngine.ts).
OPENAI_API_KEY=

# Optional — the ONLY variable you need to set to enable shorky-cloud
# integration (Playwright telemetry reporter, /api/webhook fix dispatch,
# and the pre-flight governance/token-budget check). When unset, all cloud
# features are skipped and the LLM repair loop always proceeds locally.
SHORKY_CLOUD_API_KEY=

# Optional — advanced override of the shorky-cloud base URL. Defaults to
# the hosted production instance (https://shorky-cloud.vercel.app) when
# unset, so most consumers never need to set this. Only set it when running
# your own local shorky-cloud server or a tunnel (e.g. ngrok) during
# development. No path/trailing slash is required — Shorky normalizes
# whatever value is provided down to just its base origin.
# SHORKY_CLOUD_URL=http://localhost:3000

# Used by src/utils/githubPr.ts / fixTrace.ts when opening auto-heal pull
# requests. Typically provided automatically inside GitHub Actions.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=
# GITHUB_REF_NAME=
