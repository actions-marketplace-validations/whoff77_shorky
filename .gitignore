.env

# Shorky's deterministic cross-process run-ID handoff file (see
# src/utils/executionId.ts's getExecutionId()) — a transient artifact
# written at runtime so the Playwright reporter process and the separate
# Shorky CLI process agree on the same execution ID; never committed.
.shorky-run-id
**/.shorky-run-id

# Compiled TypeScript artifacts that should never live inside src/
src/**/*.js
src/**/*.js.map
playwright.js
playwright.js.map
/playwright.config.js
